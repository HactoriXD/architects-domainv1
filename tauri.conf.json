{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "http://localhost:3000",
    "distDir": "../"
  },
  "package": {
    "productName": "Architects Domain",
    "version": "0.2.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false
      },
      "dialog": {
        "all": true
      },
      "fs": {
        "all": true,
        "scope": ["**/*"]
      }
    },
    "bundle": {
      "active": true,
      "targets": ["app", "dmg", "deb", "appimage", "nsis"],
      "icon": [
        "icons/icon.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 900,
        "resizable": true,
        "title": "Architect's Domain",
        "width": 1400,
        "minWidth": 1000,
        "minHeight": 700
      }
    ]
  }
}